FINNHUB_API_KEY=your_finnhub_key_here
NEWS_API_KEY=your_newsapi_key_here
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret

# DATABASE_URL defaults to sqlite:///<project_root>/outlierq.db
# Override for PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/outlierq
DATABASE_URL=sqlite:///outlierq.db

# FinBERT settings (optional)
FINBERT_DEVICE=cpu
FINBERT_BATCH_SIZE=16
